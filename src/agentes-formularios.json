                },
                {
                  "value": "30s",
                  "label": "Médio: 30 segundos"
                },
                {
                  "value": "45s",
                  "label": "Longo: até 45 segundos"
                }
              ]
            },
            {
              "id": "formato",
              "label": "2. Formato",
