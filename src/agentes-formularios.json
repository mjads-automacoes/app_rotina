      "approval_cards": {
        "otm": {
          "label": "Otimização (OTM)",
          "created_by": "agente",
          "code_pattern": "OTM-NNN",
          "item_kinds": {
            "auto": "o escritório faz após aprovo",
            "manual": "o gestor faz"
          },
          "auto_allowed": [
            "negativas",
            "adicionar_palavra",
            "pausar_palavra",
            "pausar_anuncio",
            "criar_anuncio"
          ],
          "never_auto": [
            "orcamento",
            "lance",
            "metas_conversao",
            "ativar_campanha",
            "pagamento"
          ],
          "actions": [
            "aprovar_selecionados",
            "recusar",
            "desfazer"
          ],
          "who": "gestor_do_cliente",
          "after_execution": "mostrar_antes_e_depois"
        }
      }
