              "help": "O escritório escreve o texto da narração. Ele vem junto com o vídeo para você conferir.",
              "option_visible_if": {
                "fala_cliente": {
                  "field": "material",
                  "in": [
                    "videos"
                  ]
                }
              }
            },
            {
              "id": "legenda",
