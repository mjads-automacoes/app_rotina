  "common_fields": [
    {
      "id": "agente",
      "label": "Agente",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "gestor_trafego",
          "label": "Gestor de Tráfego"
        },
        {
          "value": "criativos",
          "label": "Criativos"
        },
        {
          "value": "dev_sites",
          "label": "Dev Sites"
        },
        {
          "value": "social_media",
          "label": "Social Media"
        }
      ]
    },
    {
      "id": "tipo",
      "label": "Tipo de pedido",
      "type": "select",
      "required": true,
      "options_from": "agente"
    },
    {
      "id": "cliente_id",
      "label": "Cliente",
      "type": "client_lookup",
      "required": true,
      "help": "Abre a ficha ao lado e pré-preenche campos marcados com prefill.",
      "validation": {
        "must_exist": true
      }
    },
    {
      "id": "prioridade",
      "label": "Prioridade",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "urgente",
          "label": "Urgente"
        },
        {
          "value": "alta",
          "label": "Alta"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "baixa",
          "label": "Baixa"
        }
      ],
      "default": "normal"
    },
    {
      "id": "prioridade_motivo",
      "label": "Motivo da urgência",
      "type": "text",
      "required": false,
      "required_if": {
        "field": "prioridade",
        "in": [
          "urgente"
        ]
      }
    },
    {
      "id": "prazo",
      "label": "Prazo",
      "type": "date",
      "required": true,
      "validation": {
        "min": "today"
      },
      "warn_if_below_min_lead_time": true
