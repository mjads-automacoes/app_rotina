            {
              "id": "produto_servico",
              "label": "Produto ou serviço",
              "type": "text",
              "required": true,
              "help": "Um foco por campanha."
            },
            {
              "id": "oferta",
              "label": "Oferta real e validade",
              "type": "offer",
              "required": true,
              "help": "Oferta + data de validade, ou 'sem oferta'.",
              "validation": {
                "allow_none_option": "sem_oferta",
                "valid_until_required_if_offer": true,
                "valid_until_min": "today"
              }
            },
            {
              "id": "cidade_raio",
              "label": "Cidade e raio",
              "type": "city_radius",
              "required": true,
              "prefill": "ficha.cidade"
            },
            {
              "id": "publico",
              "label": "Público",
              "type": "textarea",
              "required": true,
              "help": "Idade, perfil e interesses."
            },
            {
              "id": "criativos",
              "label": "Criativos aprovados",
              "type": "request_ref_or_upload",
              "required": true,
              "source": {
                "agent": "criativos",
                "client": "same",
                "status": "concluido"
              }
            },
            {
              "id": "textos",
              "label": "Textos aprovados",
              "type": "text_or_link",
              "required": true,
              "allow_none_option": "criar_com_base_na_ficha"
