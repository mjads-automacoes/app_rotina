              "required": true,
              "options": [
                {
                  "value": "whatsapp",
                  "label": "Conversas no WhatsApp"
                },
                {
                  "value": "leads",
                  "label": "Leads"
                },
                {
                  "value": "landing_page",
                  "label": "Acessos à landing page"
