    "criativos": {
      "label": "Criativos",
      "notice": "A IA cria cenas do tipo de serviço. Nunca inventa a fachada, a equipe ou o trabalho real do cliente.",
      "forms": {
        "video": {
          "label": "Vídeo",
          "fields": [
            {
              "id": "uso",
