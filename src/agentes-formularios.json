    {
      "id": "solicitante_id",
      "label": "Solicitante",
      "type": "current_user",
      "required": true,
      "readonly": true
    },
    {
      "id": "aprovador_id",
      "label": "Responsável pela aprovação",
      "type": "user",
      "required": true,
      "default_by_agent": {
        "gestor_trafego": "gestor_do_cliente",
        "criativos": "solicitante",
        "dev_sites": "solicitante",
        "social_media": "pablo"
      }
    },
    {
      "id": "observacoes",
      "label": "Observações",
      "type": "textarea",
      "required": false
    },
    {
      "id": "anexos",
      "label": "Anexos gerais",
      "type": "upload_or_drive",
      "required": false,
      "validation": {
        "max_mb_per_file": 50
      },
      "audio_transcribe": true
    }
  ],
  "min_lead_time": {
    "same_day_if_before": "16:00",
    "same_day_types": [
      "criativos.imagem",
      "social_media.post",
      "gestor_trafego.analise_conta"
