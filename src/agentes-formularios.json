              },
              "prefill": "ficha.whatsapp_comercial",
              "validation": {
                "phone": "ddd_required",
                "url": "https_only"
              }
            },
            {
              "id": "orcamento_diario",
              "label": "Orçamento diário combinado",
              "type": "currency_brl",
              "required": true,
              "warn_if_above": "ficha.orcamento_combinado"
