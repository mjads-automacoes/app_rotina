            {
              "id": "gestor_id",
              "label": "Gestor que vai revisar e publicar",
              "type": "user",
              "required": true,
              "sets": "aprovador_id"
            }
          ],
          "returns": [
            "link_rascunho",
            "resumo_estrutura",
            "checklist_ativacao"
          ]
