          "fields": [
            {
              "id": "meta_ad_account_id",
              "label": "ID da conta de anúncio",
              "type": "text",
              "required": true,
              "prefill": "ficha.meta_ad_account_id",
              "offer_save_to_ficha": true
            },
            {
              "id": "paginas",
              "label": "Página do Facebook e Instagram",
